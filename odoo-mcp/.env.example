# Copy to .env and fill in — NEVER commit the real .env (it is gitignored).
# These can also be supplied directly in the Claude MCP server config "env" block.

# Base URL of your Odoo instance (no trailing /web path)
ODOO_URL=https://your-odoo-host.example.com

# Database name. Run `npm run discover` to find it if you're unsure.
# For Odoo Online this is usually your subdomain (e.g. "mycompany").
ODOO_DB=

# Your login (email)
ODOO_USERNAME=you@example.com

# API key: Odoo → top-right avatar → My Profile → Account Security → New API Key.
# (A plain account password also works if API keys are not enforced.)
ODOO_API_KEY=

# Optional: request timeout in milliseconds (default 30000)
# ODOO_TIMEOUT=30000
